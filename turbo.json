{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [".env", "tsconfig.json"],
	"globalEnv": ["NODE_ENV"],
	"tasks": {
		"build": {
			"cache": true,
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputLogs": "full",
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"dependsOn": ["^build"],
			"outputLogs": "full",
			"persistent": true
		},
		"lint": {
			"cache": true,
			"inputs": [
				"src/**/*.{ts,tsx,vue}",
				".eslintrc.{js,cjs,json}",
				".oxlintrc",
				".prettierignore",
				".prettierrc.{js,cjs,json}",
				"tsconfig.json"
			],
			"outputLogs": "full"
		},
		"preview": {
			"cache": false,
			"dependsOn": ["build"],
			"outputLogs": "full"
		},
		"coverage": {
			"cache": true,
			"inputs": ["src/**/*.{ts,tsx,vue}", "**/*.{test,spec}.{ts,tsx}"],
			"outputLogs": "full",
			"outputs": ["coverage/**"]
		},
		"e2e": {
			"cache": false,
			"outputLogs": "full",
			"outputs": ["playwright-report/**", "test-results/**"]
		},
		"unit": {
			"cache": true,
			"inputs": ["src/**/*.{ts,tsx,vue}", "**/*.{test,spec}.{ts,tsx}"],
			"outputLogs": "full",
			"outputs": ["coverage/**"]
		},
		"report": {
			"cache": false,
			"persistent": true,
			"outputLogs": "full"
		}
	}
}
