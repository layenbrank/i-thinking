{
	"compilerOptions": {
		"target": "esnext",
		"useDefineForClassFields": true,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"skipLibCheck": true,

		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",

		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,

		"types": [
			"vite/client",
			"@types/chrome",
			"reflect-metadata",
			"ant-design-vue/typings/global",
			"@desktop-app/core/directives",
			"@desktop-app/shared/response",
			"@desktop-app/shared/decorator",
			"@desktop-app/shared/constructor",
			"@desktop-app/shared/contextmenu",
			"@desktop-app/shared/user-profile",
			"@desktop-app/shared/app-bookmark",
			"@desktop-app/shared/app-controller",
			"@desktop-app/shared/application",
			"@desktop-app/shared/application-settings",
			"@desktop-app/shared/application-backup"
		],

		"rootDir": ".",

		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
	"references": [{ "path": "./tsconfig.node.json" }]
}
