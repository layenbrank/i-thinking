{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "vite.config-d.ts",
    "cypress.config.*",
    "nightwatch.conf.*",
    "playwright.config.*",
    "tailwind.config.*",
    "eslint.config.*",
    "scripts/**/*.ts"
  ],
  "exclude": ["postcss.config.js"],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "@i-thinking/shared/process-env"],

    "rootDir": ".",
    "baseUrl": "."
  }
}
