{
	"extends": "@tsconfig/node24/tsconfig.json",
	"include": [
		"vite.config.*",
		"vitest.config.*",
		"cypress.config.*",
		"nightwatch.conf.*",
		"playwright.config.*",
		"tailwind.config.*",
		"eslint.config.*",
		"vite.config.ts",
		"vite.config-d.ts"
	],
	"compilerOptions": {
		"noEmit": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",

		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["node", "@desktop-app/shared/process-env"]
	}
}
