{
	"chrome_url_overrides": {
		"newtab": "index.html"
	},
	"description": "desktop-apps",
	"externally_connectable": {
		"matches": ["<all_urls>"]
	},
	"host_permissions": ["<all_urls>", "https://*/*", "http://*/*"],
	"incognito": "split",
	"manifest_version": 3,
	"name": "桌面应用",
	"permissions": [
		"storage",
		"history",
		"sidePanel",
		"contextMenus",
		"tabs",
		"activeTab",
		"devtools",
		"tts",
		"proxy",
		"mdns",
		"geolocation",
		"declarativeNetRequest",
		"ttsEngine",
		"bookmarks"
	],
	"version": "1.0.0",
	"web_accessible_resources": [
		{
			"matches": ["<all_urls>"],
			"resources": ["*"]
		}
	]
}
