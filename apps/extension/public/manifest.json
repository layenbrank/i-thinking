{
	"chrome_url_overrides": {
		"newtab": "index.html"
	},
	"description": "desktop-apps",
	"externally_connectable": {
		"matches": ["<all_urls>"]
	},
	"host_permissions": ["<all_urls>", "http://*/*", "https://*/*"],
	"incognito": "split",
	"key": "",
	"manifest_version": 3,
	"name": "桌面应用",
	"permissions": ["storage", "history", "sidePanel", "contextMenus", "tabs", "activeTab"],
	"version": "1.3.0",
	"web_accessible_resources": [
		{
			"matches": ["<all_urls>"],
			"resources": ["*"]
		}
	]
}
