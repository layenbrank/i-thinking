{
  "name": "@i-thinking/extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "run-s build:pre build:core build:post",
    "build:pre": "bun run scripts/build-prefix.ts",
    "build:core": "run-p type-check \"build-only {@}\" --",
    "build:post": "bun run scripts/build-suffix.ts",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "preview": "vite preview",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix --cache",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "unit": "vitest",
    "e2e": "playwright test",
    "coverage": "vitest --coverage"
  },
  "dependencies": {
    "@i-thinking/utils": "workspace:*",
    "@i-thinking/directives": "workspace:*",
    "@i-thinking/composables": "workspace:*",
    "@i-thinking/wasm": "workspace:*"
  },
  "devDependencies": {
    "@i-thinking/shared": "workspace:*"
  }
}
