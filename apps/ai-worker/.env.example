# ai-worker 配置样例。`cp .env.example .env` 后按需修改；
# 字段名 → 环境变量：`internal_token` → `AI_WORKER_INTERNAL_TOKEN`（前缀固定，大小写不敏感）。
# 真实值只写进 .env / 部署密钥，不要提交（.env 已在 .gitignore 里）。

# development | test | production
AI_WORKER_ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
AI_WORKER_LOG_LEVEL=INFO

# 只监听内网地址：外部可达时 X-Internal-Token 就是一把暴露在公网的共享密钥。
AI_WORKER_HOST=127.0.0.1
AI_WORKER_PORT=8081

# ── 必填（缺失即启动失败，没有默认值）────────────────────────────────────────
# core 配置里的 `ai_worker.token`，即请求头 X-Internal-Token 的值。
# 这是 core 与 ai-worker 之间唯一的共享密钥；建议 ≥ 32 字符，短了会打 WARNING。
# 注意：它是 core 的 `ai_worker.token`，**不是** `gateway.service_token_secret`。
AI_WORKER_INTERNAL_TOKEN=change-me-to-a-32-plus-character-random-string
# 必须是 ai-worker 自己的库（跑完迁移后里面只会有 schema_migration / idempotency_key 两张表），
# 不能指向 core 的业务库（tests/test_db_boundary.py 会把这条边界钉死）。
AI_WORKER_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55433/ai_worker_test
# core 的基址，不带尾斜杠；只用来换取服务令牌、读资产正文、请求嵌入算力。
# 端口要跟 core 配置里的 `server.port` 对上（仓库默认 3000，不是 8080——8080 是 gocaptcha 侧车）。
AI_WORKER_CORE_BASE_URL=http://127.0.0.1:3000

# ── 出站调用（可选）────────────────────────────────────────────────────────
# 单次请求超时（秒）。
AI_WORKER_CORE_TIMEOUT_SECONDS=30
# 服务令牌提前多少秒续签，避免「刚好在过期那一瞬间发出请求」。
AI_WORKER_CORE_TOKEN_REFRESH_SKEW_SECONDS=30
# 申请服务令牌时希望的有效期（秒）；留空 = 用 core 的默认值（core 侧收敛到上限 3600）。
# 不能写成 `AI_WORKER_CORE_SERVICE_TOKEN_TTL_SECONDS=`（空串不是合法的整数，会启动失败），要留空就整行注释掉。
# AI_WORKER_CORE_SERVICE_TOKEN_TTL_SECONDS=1800
# 单个资产正文的大小上限（字节）；超过判为不可重试的请求问题（400），不落库。
AI_WORKER_ASSET_MAX_BYTES=67108864
# 幂等键停留在「进行中」超过多久即可被后来的请求接管（秒）。
AI_WORKER_IDEMPOTENCY_STALE_SECONDS=900

# ── 分块（可选）────────────────────────────────────────────────────────────
# 请求体里省略 chunkSize / chunkOverlap 时用的目标值：块大小（字符）与块间重叠（字符）。
# 重叠必须严格小于块大小，否则启动失败。单个块的实际长度可能略超 chunkSize（为了不切断句子）。
AI_WORKER_DEFAULT_CHUNK_SIZE=1200
AI_WORKER_DEFAULT_CHUNK_OVERLAP=200

# ── 嵌入（可选）────────────────────────────────────────────────────────────
# 一次 POST /service/embeddings 里塞多少个块。分小批是为了：单次响应别太大、
# 上游超时别拖垮整个区间（已经算好的批会先落库，重试时只补缺）。
AI_WORKER_EMBED_BATCH_SIZE=64

# ── 数据库（可选）──────────────────────────────────────────────────────────
AI_WORKER_DB_POOL_MIN_SIZE=1
AI_WORKER_DB_POOL_MAX_SIZE=10
AI_WORKER_DB_CONNECT_TIMEOUT_SECONDS=5
AI_WORKER_DB_COMMAND_TIMEOUT_SECONDS=60
# 库不可用时的降级行为：服务照常起来并回 503 degraded，探针按这个间隔重试重连（秒）。
AI_WORKER_DB_RECONNECT_INTERVAL_SECONDS=5

# ── 链路追踪（可选，默认关闭）──────────────────────────────────────────────
# 关闭时进程里不注册任何 OTel 全局状态、不联网；跨进程仍靠内置的 W3C 实现透传 traceparent
# （见 src/ai_worker/trace.py），行为与接入前逐字一致。
AI_WORKER_TELEMETRY_ENABLED=false
# OTLP/HTTP 基址：不带路径时自动补 /v1/traces，带路径则原样使用（与 core 同规则）。
# 本地 Jaeger 的 OTLP 端口是 4318，UI 在 16686。
AI_WORKER_TELEMETRY_ENDPOINT=http://127.0.0.1:4318
# 资源里的 service.name：后端按它筛服务，不能为空。
AI_WORKER_TELEMETRY_SERVICE_NAME=i-thinking-ai-worker
# 采样比例 0.0–1.0；上游已带采样决定时跟随上游（ParentBased），只有根 span 才掷骰子。
AI_WORKER_TELEMETRY_SAMPLE_RATIO=1.0
# 单次导出超时（毫秒）。
AI_WORKER_TELEMETRY_TIMEOUT_MS=10000
