{
	"compilerOptions": {
		"composite": true,

		"declaration": true,
		"emitDeclarationOnly": true,

		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,

		"resolveJsonModule": true,

		"baseUrl": ".",
		"rootDir": ".",

		"outDir": "dist",

		"paths": {
			"@/*": ["src/*"]
		},

		"types": ["vite/client"],
		"tsBuildInfoFile": "./node_modules/.cache/.tsbuildinfo.core"
	},
	"exclude": ["dist", "node_modules", "./.vitepress/cache/**/*.js"],
	"include": ["./.vitepress/**/*.ts"]
}
