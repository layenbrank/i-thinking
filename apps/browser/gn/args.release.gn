# Official release (non-component) build for i-thinking Chromium fork.
# Copy via: pnpm command browser configure --release (merges gn/args.release.local.gn if present).

is_debug = false
is_component_build = false
is_official_build = true
target_cpu = "x64"
symbol_level = 0
blink_symbol_level = 0
# Official builds default to PGO; profiles are large and need
# checkout_pgo_profiles in .gclient. Disable unless you explicitly sync them.
chrome_pgo_phase = 0

# Google API keys: do NOT put real secrets in this tracked file.
# Copy args.release.local.gn.example -> args.release.local.gn and fill values.
# That local file is gitignored and merged at configure time.
