# ============================================================
# Search 模块 /api/v1/search （Elasticsearch）
# 鉴权: Bearer JWT
# ============================================================

@host = http://127.0.0.1:3000
@username = admin
@password = 123456

### 先登录取 token
# @name signin
POST {{host}}/api/v1/auth/signin
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

###
@token = {{signin.response.body.data.token}}

### POST /api/v1/search/docs — 索引文档
POST {{host}}/api/v1/search/docs
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "CoreX Redis Elasticsearch",
  "content": "企业级 Rust 服务接入 Redis 黑名单与 ES 全文检索"
}

### GET /api/v1/search/docs — 全文检索
GET {{host}}/api/v1/search/docs?q=Redis&size=10
Authorization: Bearer {{token}}
Accept: application/json
