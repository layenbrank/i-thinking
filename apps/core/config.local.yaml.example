# 复制为 config.local.yaml（不入库），覆盖本机密钥与连接串。

database:
  url: postgres://machenike:Li33333.@127.0.0.1:5432/i-thinking

security:
  secret: your-local-secret
  jwt_secret: your-local-jwt-secret-at-least-32-characters-long
  # encryption: aes
  # aes_key: your-base64-aes-key

auth:
  captcha:
    # enabled: false   # 临时关闭校验（开发联调）
    api_key: change-me-gocaptcha-key

aliyun:
  gateway:
    api_key: change-me-aliyun-gateway-key

# 事件发布终点与鉴权（只有 worker 用得到；api 二进制不读它）。
# 本机联调可留空：endpoint 为空时 worker 只记日志。
events:
  endpoint: ''
  token: ''

redis:
  url: redis://127.0.0.1:6379

elasticsearch:
  url: http://127.0.0.1:9200

# 支付渠道凭据（均为敏感值，只放本机/部署环境，见 src/services/payment/README.md）。
# enabled: true 时会强校验必填项：宁启动失败，也不带半截凭据上线。
# 回调地址必须公网 HTTPS；本机联调用内网穿透或反向代理，否则只能靠订单 sync 兜底。
pay:
  wechat:
    enabled: false
    mch_id: ''
    app_id: ''
    api_v3_key: '' # 32 字符
    serial_no: ''
    private_key: '' # apiclient_key.pem 内容
    platform_public_key: '' # 平台证书公钥 PEM
    notify_url: https://your-domain.com/api/v1/pay/notify/wechat
  alipay:
    enabled: false
    app_id: ''
    private_key: ''
    alipay_public_key: ''
    notify_url: https://your-domain.com/api/v1/pay/notify/alipay
