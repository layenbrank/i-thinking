# corex 全栈 compose 的插值变量（apps/core/docker-compose.yml 里的 ${VAR}）。
#
#   cp .env.example .env
#
# 本文件只负责 compose 插值（凭据、镜像名、链路开关）；要往 core 容器里注入额外的
# CORE__* 配置项，请写 docker/stack.env（模板见 docker/stack.env.example）。
# .env 本身不入库（apps/core/.gitignore），真实密钥不要提交。

# ── 必填：compose 没给默认值，缺任何一项都会直接报错退出 ─────────────────────
# 改本机 Postgres 密码要注意：容器只在 ./data/postgres 首次 initdb 时读取它，
# 已有数据卷会继续用旧密码，需要 ALTER USER 或删掉 ./data/postgres 重新初始化。
POSTGRES_PASSWORD=Li33333.
# core 与 ai-worker 的长期共享令牌（两侧必须完全一致）
AI_WORKER_INTERNAL_TOKEN=dev-internal-token
# ai-worker 用它换短期服务令牌；留空 = /api/v1/service/** 整体 503
SERVICE_TOKEN_SECRET=dev-service-token-secret

# ── 可选：compose 已有指向本机开发的默认值，按需覆盖 ────────────────────────
# APP_ENV=development
# AI_WORKER_ENVIRONMENT=development
# TELEMETRY_ENABLED=true
# OTLP_ENDPOINT=http://jaeger:4318

# ── 生产：上面三个凭据必须换成随机值（`openssl rand -base64 36`）并把
# APP_ENV 切到 production。其余生产必填项见 docker/stack.env.example 与
# guide/deployment.md §8。
