{
  "name": "@i-thinking/studio",
  "productName": "i thinking",
  "description": "i thinking Studio - Electron desktop app",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "dev:core": "vite",
    "package": "electron-forge package",
    "build": "run-s type-check package",
    "type-check": "tsc --build",
    "make": "electron-forge make",
    "make:win": "electron-forge make --platform=win32",
    "make:mac": "electron-forge make --platform=darwin",
    "make:linux": "electron-forge make --platform=linux",
    "publish": "electron-forge publish",
    "publish:github": "electron-forge publish",
    "lint": "eslint . --report-unused-disable-directives",
    "postinstall": "electron-rebuild",
    "rebuild": "electron-rebuild",
    "preview": "vite preview",
    "test:coverage": "vitest --coverage",
    "test:db": "node scripts/run-db-tests.mjs",
    "test:e2e": "playwright test",
    "test:unit": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "catalog:",
    "@assistant-ui/ai-sdk": "catalog:",
    "@assistant-ui/react": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@i-thinking/chat": "workspace:*",
    "@i-thinking/design": "workspace:*",
    "@i-thinking/utils": "workspace:*",
    "@i-thinking/wasm": "workspace:*",
    "ai": "catalog:",
    "better-sqlite3": "catalog:",
    "drizzle-orm": "catalog:",
    "electron-squirrel-startup": "catalog:",
    "electron-store": "catalog:",
    "electron-updater": "catalog:",
    "lucide-react": "catalog:",
    "sonner": "catalog:",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "catalog:",
    "@electron-forge/maker-deb": "catalog:",
    "@electron-forge/maker-dmg": "catalog:",
    "@electron-forge/maker-flatpak": "catalog:",
    "@electron-forge/maker-msix": "catalog:",
    "@electron-forge/maker-pkg": "catalog:",
    "@electron-forge/maker-rpm": "catalog:",
    "@electron-forge/maker-squirrel": "catalog:",
    "@electron-forge/maker-wix": "catalog:",
    "@electron-forge/maker-zip": "catalog:",
    "@electron-forge/plugin-auto-unpack-natives": "catalog:",
    "@electron-forge/plugin-fuses": "catalog:",
    "@electron-forge/plugin-vite": "catalog:",
    "@electron-forge/publisher-github": "catalog:",
    "@electron-forge/publisher-s3": "catalog:",
    "@electron-forge/shared-types": "catalog:",
    "@electron/fuses": "catalog:",
    "@electron/rebuild": "catalog:",
    "@electron/windows-sign": "catalog:",
    "@i-thinking/shared": "workspace:*",
    "@types/electron-squirrel-startup": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "drizzle-kit": "catalog:",
    "electron": "catalog:"
  },
  "keywords": [],
  "author": {
    "name": "lh",
    "email": "15638470820@163.com"
  },
  "license": "MIT"
}
