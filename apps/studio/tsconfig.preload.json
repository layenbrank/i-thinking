{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.preload.tsbuildinfo",
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@preload/*": ["./src/preload/*"],
      "@main/*": ["./src/main/*"]
    }
  },
  "include": [
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/main/modules/**/schemas.ts"
  ],
  "exclude": ["**/node_modules/**", "**/*.test.ts"]
}
