{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ESNext",
    "module": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Optimizations */
    "isolatedModules": true,
    "resolveJsonModule": true,

    "types": [
      "vite/client",
      "@types/react",
      "@types/react-dom",
      "@types/chrome",
      "reflect-metadata",
      "unplugin-icons/types/react",
      "@i-thinking/utils",
      "@i-thinking/hooks",
      "@i-thinking/shared/response",
      "@i-thinking/shared/decorator",
      "@i-thinking/shared/constructor",
      "@i-thinking/shared/contextmenu",
      "@i-thinking/shared/user-profile",
      "@i-thinking/shared/schema",
      "@i-thinking/shared/backup",
      "@i-thinking/shared/mirror",
      "@i-thinking/shared/settings",
      "@i-thinking/shared/controller",
      "@i-thinking/shared/application",
      "@i-thinking/shared/application-bookmark",
      "@i-thinking/shared/application-markdown",
      "@electron-forge/plugin-vite/forge-vite-env",
      "@i-thinking/shared/application-intelligence"
    ],

    /* Path */
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@shared/*": ["./src/shared/*"],
      "@main/*": ["./src/main/*"],
      "@preload/*": ["./src/preload/*"],
      "@generated/*": ["./generated/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
