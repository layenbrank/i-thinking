// Prisma schema for studio (SQLite via better-sqlite3 adapter in main process)
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

