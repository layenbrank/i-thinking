// Prisma schema for studio (SQLite via better-sqlite3 adapter in main process)
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Add models as needed; IPC db:query/db:execute use $queryRaw/$executeRaw
model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String?
  email     String?
}
