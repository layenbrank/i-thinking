// Prisma schema for studio (SQLite via better-sqlite3 adapter in main process)
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Domain access via main DatabaseModule repositories (no raw SQL IPC)
model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String?
  email     String?
}

model Application {
  id   String  @id @default(uuid())
  name String?
  url  String
}
