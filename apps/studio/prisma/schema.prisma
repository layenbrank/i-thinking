// Prisma schema for studio (SQLite via better-sqlite3 adapter in main process)
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Domain access via main DatabaseModule repositories (no raw SQL IPC)
model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String?
  email     String?
}
