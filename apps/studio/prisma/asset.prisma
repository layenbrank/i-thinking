// ── asset（资产文件）──
model Asset {
  id         String  @id
  tenantID   String? @map("tenantID")
  kind       String?
  hash       String?
  sha        String  @default("sha256")
  size       BigInt?
  index      BigInt  @default(1)
  mime       String
  extension  String?
  fileName   String  @map("fileName")
  filePath   String  @map("filePath")
  metadata   String?
  status     String  @default("001")
  version    BigInt  @default(1)
  deviceID   String? @map("deviceID")
  archivedAt BigInt? @map("archivedAt")
  createdAt  BigInt  @map("createdAt")
  updatedAt  BigInt  @map("updatedAt")

  @@index([hash])
  @@index([filePath])
  @@map("asset")
}
