{
  "name": "@i-thinking/client",
  "private": true,
  "type": "module",
  "version": "1.2.14",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "build:core": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "check:cargo": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:tauri": "run-s prepare:bin check:cargo",
    "dev": "run-s prepare:bin dev:tauri",
    "dev:core": "vite",
    "dev:tauri": "tauri dev",
    "prepare:bin": "bun run scripts/prepare.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:unit": "vitest",
    "type-check": "tsc --build"
  },
  "dependencies": {
    "@ant-design/colors": "catalog:",
    "@ant-design/icons": "catalog:",
    "@ant-design/x": "catalog:",
    "@ant-design/x-markdown": "catalog:",
    "@i-thinking/utils": "workspace:*",
    "@i-thinking/wasm": "workspace:*",
    "antd": "catalog:",
    "antd-style": "catalog:"
  },
  "devDependencies": {
    "@i-thinking/shared": "workspace:*"
  }
}
