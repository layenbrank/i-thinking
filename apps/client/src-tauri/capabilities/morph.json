{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "morph-capability",
  "description": "Capability for the morph PDF editor window",
  "platforms": ["macOS", "windows", "linux"],
  "windows": ["morph"],
  "permissions": [
    "core:webview:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "dialog:allow-open",
    "dialog:allow-save",
    "sql:default",
    "http:default",
    "opener:default"
  ]
}
