{
  "$schema": "../gen/schemas/desktop-schema.json",
  "description": "Capability for the main window",
  "identifier": "default",
  "permissions": [
    "core:default",
    "opener:default",
    "core:webview:default",
    {
      "allow": [
        {
          "app": "msedge",
          "url": "https://cn.bing.com"
        },
        {
          "app": "chrome",
          "url": "https://www.baidu.com"
        },
        {
          "app": true,
          "url": "https://*"
        },
        {
          "app": true,
          "url": "http://*"
        },
        {
          "url": "custom:*"
        },
        {
          "app": true,
          "url": "*"
        }
      ],
      "identifier": "opener:allow-open-url"
    },
    {
      "allow": [
        {
          "app": true,
          "url": "https://www.baidu.com"
        },
        {
          "app": "msedge",
          "url": "https://cn.bing.com"
        },
        {
          "app": true,
          "url": "https://*"
        },
        {
          "app": true,
          "url": "http://*"
        },
        {
          "app": true,
          "url": "*"
        }
      ],
      "identifier": "opener:allow-default-urls"
    },
    {
      "allow": [
        {
          "path": "$APPDATA/*"
        },
        {
          "path": "$HOME/*"
        },
        {
          "path": "$DOCUMENTS/*"
        },
        {
          "path": "$DOWNLOADS/*"
        },
        {
          "path": "$DESKTOP/*"
        },
        {
          "path": "$PICTURES/*"
        },
        {
          "path": "$VIDEOS/*"
        },
        {
          "path": "$MUSICS/*"
        }
      ],
      "identifier": "fs:default"
    },
    "core:webview:allow-clear-all-browsing-data",
    "core:webview:allow-webview-size",
    "shell:allow-execute",
    "fs:allow-write",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-download-write",
    "fs:allow-download-write-recursive",
    "fs:allow-runtime-write",
    "fs:allow-runtime-write-recursive",
    "fs:allow-home-write",
    "fs:allow-home-write-recursive",
    "core:webview:allow-create-webview",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-internal-toggle-devtools",
    "core:webview:allow-webview-close",
    "core:webview:allow-webview-show",
    "core:webview:allow-print",
    "core:webview:allow-set-webview-auto-resize",
    "core:webview:allow-set-webview-background-color",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-unminimize",
    "core:window:allow-destroy",
    "websocket:default",
    "websocket:allow-connect",
    "websocket:allow-send",
    "fs:default",
    "dialog:default",
    "shell:default",
    "shell:allow-kill",
    {
      "allow": [
        {
          "args": [],
          "name": "",
          "cmd": ""
        }
      ],
      "identifier": "shell:allow-open"
    },
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "store:default",
    "process:default",
    "positioner:default",
    "notification:default",
    "clipboard-manager:default",
    "log:default",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-load",
    "sql:allow-close",
    "sql:allow-select",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "core:app:allow-app-hide",
    "core:app:allow-app-show",
    "core:app:allow-set-app-theme",
    {
      "identifier":"http:allow-fetch-send",
      "allow": [
          {
          "url": "http://**"
        },
        {
          "url": "https://**"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        }
      ]
    },
    {
      "identifier":"http:allow-fetch-read-body",
      "allow": [
          {
          "url": "http://**"
        },
        {
          "url": "https://**"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        }
      ]
    },
    {
      "identifier":"http:allow-fetch-cancel",
      "allow": [
          {
          "url": "http://**"
        },
        {
          "url": "https://**"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        }
      ]
    },
    {
      "identifier": "http:allow-fetch",
      "allow": [
        {
          "url": "http://**"
        },
        {
          "url": "https://**"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        }
      ]
    },
    {
      "allow": [
        {
          "url": "https://*.tauri.app"
        },
        {
          "url": "https://private.tauri.app"
        },
        {
          "url": "http://**"
        },
        {
          "url": "https://**"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        }
      ],
      "identifier": "http:default"
    }
  ],
  "platforms": ["iOS", "macOS", "linux", "windows", "android"],
  "remote": {
    "urls": [
      "http://*",
      "https://*",
      "http://localhost:*",
      "https://www.baidu.com",
      "https://*.baidu.com",
      "https://cn.bing.com",
      "https://*.bing.com",
      "https://www.youku.com",
      "https://*.youku.com",
      "https://game.weixin.qq.com",
      "https://*.weixin.qq.com"
    ]
  },
  "windows": ["main", "navigation"]
}
