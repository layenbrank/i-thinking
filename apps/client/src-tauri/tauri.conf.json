{
	"$schema": "https://schema.tauri.app/config/2",
	"app": {
		"macOSPrivateApi": true,
		"withGlobalTauri": true,
		"security": {
			"headers": {
				"Service-Worker-Allowed": "/",
				"Cross-Origin-Opener-Policy": "same-origin",
				"Cross-Origin-Embedder-Policy": "require-corp",
				"Timing-Allow-Origin": ["https://developer.mozilla.org", "https://example.com"],
				"X-Content-Type-Options": null, // gets ignored
				"Access-Control-Expose-Headers": "Tauri-Custom-Header",
				"Tauri-Custom-Header": {
					"key1": "'value1' 'value2'",
					"key2": "'value3'"
				}
			},
			"assetProtocol": {
				"enable": true,
				"scope": ["*", "https://www.baidu.com", "http://localhost:5173"]
			},
			"devCsp": {
				"default-src": "*",
				"img-src": "*",
				"script-src": "*",
				"style-src": "*",
				"frame-src": "*",
				"connect-src": "*",
				"font-src": "*"
			},
			"csp": {
				"default-src": "*",
				"img-src": "*",
				"script-src": "*",
				"style-src": "*",
				"frame-src": "*",
				"connect-src": "*",
				"font-src": "*"
			}
		},
		"windows": [
			{
				"backgroundColor": "#00000000",
				"center": true,
				"decorations": true,
				"skipTaskbar": false,
				"devtools": true,
				"dragDropEnabled": false,
				"focus": true,
				"height": 600,
				"closable": true,
				"maximizable": true,
				"contentProtected": false,
				"create": true,
				"resizable": true,
				"fullscreen": false,
				"hiddenTitle": true,
				"shadow": true,
				"dataDirectory": "i thinking",
				"theme": "Light",
				"title": "i thinking",
				"titleBarStyle": "Transparent",
				"transparent": true,
				"width": 800,
				"windowClassname": "i-thinking",
				"browserExtensionsEnabled": true,
				"windowEffects": {
					"effects": ["micaLight", "mica", "micaDark", "acrylic"]
				}
			}
		]
	},
	"build": {
		"beforeBuildCommand": "pnpm build:core",
		"beforeDevCommand": "pnpm dev:core",
		"devUrl": "http://localhost:5173",
		"frontendDist": "../dist"
	},
	"bundle": {
		"active": true,
		"publisher": "Example Inc.",
		"resources": {},
		"targets": "all",
		"externalBin": [],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],

		"linux": {
			"appimage": {
				"bundleMediaFramework": false,
				"files": {}
			},
			"deb": {
				"files": {}
			},
			"rpm": {
				"epoch": 0,
				"files": {},
				"release": "1"
			}
		},
		"macOS": {
			"dmg": {
				"applicationFolderPosition": {
					"x": 480,
					"y": 170
				},
				"appPosition": {
					"x": 180,
					"y": 170
				},
				"windowSize": {
					"height": 400,
					"width": 660
				}
			},
			"files": {},
			"hardenedRuntime": true,
			"minimumSystemVersion": "10.13"
		},
		"windows": {
			"allowDowngrades": true,
			"certificateThumbprint": null,
			"digestAlgorithm": null,
			"nsis": {
				"displayLanguageSelector": true
			},
			"signCommand": null,
			"timestampUrl": null,
			"tsp": false,
			"webviewInstallMode": {
				"silent": true,
				"type": "downloadBootstrapper"
			},
			"wix": {
				"language": ["zh-CN", "en-US"]
			}
		}
	},
	"identifier": "com.i-thinking.corex",
	"productName": "i thinking",
	"version": "0.1.0",
	"plugins": {}
}
