{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "*",
          "https://*",
          "http://*",
          "https://www.baidu.com",
          "http://localhost:5173",
          "http://192.168.0.4:5173"
        ]
      },
      "csp": {
        "font-src": "*",
        "frame-src": "*",
        "default-src": "* 'self' blob: data: filesystem: ws: wss: tauri: 'unsafe-eval' 'unsafe-inline' http://localhost:11434",
        "connect-src": "* ipc: http://ipc.localhost https://api.yourdomain.com http://localhost:11434 data: *",
        "img-src": "* 'self' blob: data: asset: https://*",
        "style-src": "'unsafe-inline' 'self' https://fonts.googleapis.com",
        "script-src": "* 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net"
      },
      "devCsp": {
        "default-src": "*",
        "connect-src": "*",
        "img-src": "*",
        "style-src": "*",
        "script-src": "*",
        "font-src": "*",
        "frame-src": "*",
        "media-src": "*",
        "object-src": "*",
        "base-uri": "*",
        "form-action": "*"
      },
      "headers": {
        "Cross-Origin-Opener-Policy": null,
        "Cross-Origin-Embedder-Policy": null,
        "Access-Control-Allow-Methods": "*",
        "Access-Control-Allow-Credentials": "true",
        "Cross-Origin-Resource-Policy": "cross-origin",
        "Access-Control-Allow-Headers": "*",
        "Timing-Allow-Origin": [
          "*",
          "https://*",
          "http://*",
          "https://developer.mozilla.org",
          "https://example.com"
        ]
      }
    },
    "windows": [
      {
        "backgroundColor": "#00000000",
        "browserExtensionsEnabled": false,
        "center": true,
        "closable": true,
        "contentProtected": false,
        "create": true,
        "decorations": true,
        "devtools": true,
        "dragDropEnabled": true,
        "focus": true,
        "fullscreen": false,
        "height": 800,
        "minHeight": 600,
        "hiddenTitle": false,
        "label": "main",
        "maximizable": true,
        "resizable": true,
        "shadow": true,
        "skipTaskbar": false,
        "theme": "Light",
        "title": "i thinking",
        "titleBarStyle": "Transparent",
        "transparent": true,
        "visible": true,
        "width": 1200,
        "minWidth": 800,
        "windowEffects": {
          "effects": ["micaLight", "mica", "micaDark", "acrylic"]
        }
      },
      {
        "label": "secondary",
        "theme": "Light",
        "shadow": true,
        "create": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": false,
        "maximized": true,
        "fullscreen": true
      },
      {
        "label": "navigation",
        "url": "/markdown",
        "theme": "Light",
        "shadow": true,
        "create": false,
        "visible": true,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "maximized": true,
        "fullscreen": false,
        "height": 800,
        "minHeight": 600,
        "width": 1200,
        "minWidth": 800,
        "backgroundColor": "#00000000",
        "transparent": true,
        "center": true,
        "dragDropEnabled": true,
        "focus": true,
        "focusable": true,
        "title": "Markdown",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": ["micaLight", "mica", "micaDark", "acrylic"]
        }
      },
      {
        "label": "navigation",
        "url": "/code",
        "theme": "Light",
        "shadow": true,
        "create": false,
        "visible": true,
        "decorations": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "maximized": true,
        "fullscreen": false,
        "height": 800,
        "minHeight": 600,
        "width": 1200,
        "minWidth": 800,
        "backgroundColor": "#00000000",
        "transparent": true,
        "center": true,
        "dragDropEnabled": true,
        "focus": true,
        "focusable": true,
        "title": "Code",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": ["micaLight", "mica", "micaDark", "acrylic"]
        }
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "beforeBuildCommand": "pnpm build:core",
    "beforeDevCommand": "pnpm dev:core",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },
      "deb": {
        "files": {}
      },
      "rpm": {
        "epoch": 0,
        "files": {},
        "release": "1"
      }
    },
    "macOS": {
      "dmg": {
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "windowSize": {
          "height": 400,
          "width": 660
        }
      },
      "files": {},
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.13"
    },
    "publisher": "i thinking",
    "resources": ["icons/"],
    "targets": "all",
    "windows": {
      "allowDowngrades": true,
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "nsis": {
        "compression": "lzma",
        "displayLanguageSelector": true,
        "installMode": "both",
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "startMenuFolder": "i thinking"
      },
      "signCommand": null,
      "timestampUrl": null,
      "tsp": false,
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": ["zh-CN", "en-US"],
        "version": "0.1.0"
      }
    }
  },
  "identifier": "com.i-thinking.corex",
  "plugins": {
    "sql": {
      "preload": ["sqlite:i-thinking.db"]
    }
  },
  "productName": "i thinking",
  "version": "0.1.0"
}
