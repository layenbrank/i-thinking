{
	"$schema": "https://schema.tauri.app/config/2",
	"app": {
		"macOSPrivateApi": true,
		"security": {
			"headers": {
				"Service-Worker-Allowed": "/"
			},
			"assetProtocol": {
				"enable": true,
				"scope": ["*", "https://www.baidu.com", "http://localhost:1420"]
			},
			"devCsp": "default-src *; img-src *; script-src * 'unsafe-inline' 'unsafe-eval'; style-src * 'unsafe-inline'; frame-src *; connect-src *;",
			"csp": "default-src *; img-src *; script-src * 'unsafe-inline' 'unsafe-eval'; style-src * 'unsafe-inline'; frame-src *; connect-src *;"
		},
		"windows": [
			{
				"backgroundColor": "#00000000",
				"center": true,
				"decorations": true,
				"skipTaskbar": false,
				"devtools": true,
				"dragDropEnabled": false,
				"focus": true,
				"height": 600,
				"hiddenTitle": true,
				"theme": "Light",
				"title": "client",
				"titleBarStyle": "Transparent",
				"transparent": true,
				"width": 800,
				"windowClassname": "client-tauri-window",
				"browserExtensionsEnabled": true,
				"windowEffects": {
					"effects": ["micaLight", "mica", "micaDark", "acrylic"]
				}
			}
		]
	},
	"build": {
		"beforeBuildCommand": "bun run build:web",
		"beforeDevCommand": "bun run dev:web",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../../../dist/client"
	},
	"bundle": {
		"active": true,
		"publisher": "Example Inc.",
		"resources": {},
		"targets": "all",
		"externalBin": [],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"linux": {
			"appimage": {
				"bundleMediaFramework": false,
				"files": {}
			},
			"deb": {
				"files": {}
			},
			"rpm": {
				"epoch": 0,
				"files": {},
				"release": "1"
			}
		},
		"macOS": {
			"dmg": {
				"applicationFolderPosition": {
					"x": 480,
					"y": 170
				},
				"appPosition": {
					"x": 180,
					"y": 170
				},
				"windowSize": {
					"height": 400,
					"width": 660
				}
			},
			"files": {},
			"hardenedRuntime": true,
			"minimumSystemVersion": "10.13"
		},
		"windows": {
			"allowDowngrades": true,
			"certificateThumbprint": null,
			"digestAlgorithm": null,
			"nsis": null,
			"signCommand": null,
			"timestampUrl": null,
			"tsp": false,
			"webviewInstallMode": {
				"silent": true,
				"type": "downloadBootstrapper"
			},
			"wix": null
		}
	},
	"identifier": "com.fluxor-corex.client",
	"productName": "client",
	"version": "0.1.0"
}
