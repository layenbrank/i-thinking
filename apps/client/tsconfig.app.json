{
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  "exclude": ["**/node_modules/**", "**/dist/**", "**/src-tauri/**", "**/coverage/**", "src/components/tiptap-ui/**", "src/components/tiptap-node/**", "src/components/tiptap-ui-primitive/**"],
  "compilerOptions": {
    /* ---------- Incremental ---------- */
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    /* ---------- Language / Emit ---------- */
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "noEmit": true,
    "skipLibCheck": true,

    /* ---------- Decorators ---------- */
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    /* ---------- Bundler (Vite) ---------- */
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "resolveJsonModule": true,

    /* ---------- Ambient types ---------- */
    "types": [
      "vite/client",
      "@types/react",
      "@types/react-dom",
      "@types/chrome",
      "reflect-metadata",
      "@i-thinking/utils",
      "@i-thinking/shared/response",
      "@i-thinking/shared/decorator",
      "@i-thinking/shared/constructor",
      "@i-thinking/shared/contextmenu",
      "@i-thinking/shared/user-profile",
      "@i-thinking/shared/schema",
      "@i-thinking/shared/backup",
      "@i-thinking/shared/mirror",
      "@i-thinking/shared/settings",
      "@i-thinking/shared/controller",
      "@i-thinking/shared/magnetic-tile",
      "@i-thinking/shared/magnetic-tile-bookmark",
      "@i-thinking/shared/magnetic-tile-markdown",
      "@i-thinking/shared/magnetic-tile-intelligence"
    ],

    /* ---------- Strictness ---------- */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,
    "erasableSyntaxOnly": true,
    /* 二期开启：索引访问更安全，存量改动面大 */
    "noUncheckedIndexedAccess": false,

    /* ---------- Lint ownership（unused → ESLint ^_） ---------- */
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    /* ---------- Paths ---------- */
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
