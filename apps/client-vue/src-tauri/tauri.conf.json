{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "client",
	"version": "0.1.0",
	"identifier": "com.client.app",
	"build": {
		"beforeDevCommand": "pnpm dev:web",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build:web",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"dragDropEnabled": true,
				"decorations": true,
				"focus": true,
				"windowClassname": "my-tauri-app",
				"title": "client",
				"width": 800,
				"height": 600,
				"transparent": true,
				"devtools": true,
				"backgroundColor": "#00000000",
				"titleBarStyle": "Transparent",
				"theme": "Light",
				"windowEffects": {
					"effects": ["micaLight", "mica", "micaDark", "acrylic"]
				},
				"center": true,
				"hiddenTitle": true
			}
		],
		"security": {
			"assetProtocol": {
				"enable": false,
				"scope": []
			},
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"windows": {
			"allowDowngrades": true,
			"certificateThumbprint": null,
			"digestAlgorithm": null,
			"nsis": null,
			"signCommand": null,
			"timestampUrl": null,
			"tsp": false,
			"webviewInstallMode": {
				"silent": true,
				"type": "downloadBootstrapper"
			},
			"wix": null
		},
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
