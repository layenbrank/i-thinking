{
  "private": true,
  "name": "turborepo-desktop",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:docs": "turbo run dev --filter=@desktop-widgets/docs",
    "dev:client": "turbo run dev --filter=@desktop-widgets/client",
    "dev:service": "turbo run dev --filter=@desktop-widgets/service",
    "dev:devtools": "turbo run dev --filter=@desktop-widgets/devtools",
    "dev:extension": "turbo run dev --filter=@desktop-widgets/extension",
    "build": "turbo run build",
    "build:docs": "turbo run build --filter=@desktop-widgets/docs",
    "build:core": "turbo run build --filter=@desktop-widgets/core",
    "build:client": "turbo run build --filter=@desktop-widgets/client",
    "build:service": "turbo run build --filter=@desktop-widgets/service",
    "build:devtools": "turbo run build --filter=@desktop-widgets/devtools",
    "build:extension": "turbo run build --filter=@desktop-widgets/extension",
    "preview": "turbo run preview",
    "preview:extension": "turbo run preview --filter=@desktop-widgets/extension",
    "cmd": "tsx scripts/commands/index.ts",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,vue,md}\"",
    "preinstall": "run-p prepare:*",
    "prepare:pnpm": "npx only-allow pnpm",
    "prepare:husky": "husky"
  },
  "dependencies": {
    "@ngify/http": "^2.0.6",
    "@tiptap/core": "^2.11.9",
    "@tiptap/extension-highlight": "^2.11.9",
    "@tiptap/extension-text-align": "^2.11.9",
    "@tiptap/pm": "^2.11.9",
    "@tiptap/starter-kit": "^2.11.9",
    "@tiptap/vue-3": "^2.11.9",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^12.8.2",
    "@vueuse/integrations": "^12.8.2",
    "@vueuse/shared": "^12.8.2",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.9.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.13",
    "deep-pick-omit": "^1.2.1",
    "dexie": "^4.0.11",
    "dexie-cloud-addon": "^4.0.11",
    "fuse.js": "^7.1.0",
    "lodash-es": "^4.17.21",
    "lunisolar": "^2.5.2",
    "monaco-editor": "^0.52.2",
    "naive-ui": "^2.41.0",
    "pinia": "^3.0.2",
    "rxjs": "^7.8.2",
    "sortablejs": "^1.15.6",
    "swiper": "^11.2.6",
    "tyme4ts": "^1.3.1",
    "uuid": "^11.1.0",
    "vfonts": "^0.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@desktop-widgets/core": "workspace:*",
    "@desktop-widgets/shared": "workspace:*",
    "@desktop-widgets/tsconfig": "workspace:*",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@tauri-apps/cli": "^2",
    "@tsconfig/node22": "^22.0.1",
    "@types/chrome": "^0.0.308",
    "@types/crypto-js": "^4.2.2",
    "@types/figlet": "^1.7.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.15.3",
    "@types/sortablejs": "^1.15.8",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitejs/plugin-vue-jsx": "^4.1.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.5.0",
    "@vue/tsconfig": "^0.7.0",
    "@vueuse/rxjs": "^13.2.0",
    "autoprefixer": "^10.4.21",
    "chalk": "^5.4.1",
    "clsx": "^2.1.1",
    "commander": "^13.1.0",
    "eslint": "^9.26.0",
    "eslint-plugin-oxlint": "^0.15.15",
    "eslint-plugin-vue": "^9.33.0",
    "figlet": "^1.8.1",
    "find-up": "^7.0.0",
    "gradient-string": "^3.0.0",
    "husky": "^9.1.7",
    "inquirer": "^12.6.0",
    "jiti": "^2.4.2",
    "npm-run-all2": "^7.0.2",
    "ora": "^8.2.0",
    "oxlint": "^0.15.15",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "rollup": "^4.40.1",
    "sass": "^1.87.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.19.4",
    "turbo": "^2.5.2",
    "typescript": "~5.7.3",
    "unplugin-auto-import": "^19.1.2",
    "unplugin-icons": "^22.1.0",
    "unplugin-vue-components": "^28.5.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-dts": "^4.5.3",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-vue-devtools": "^7.7.6",
    "vite-plugin-vue-mcp": "^0.3.2",
    "vue-tsc": "^2.2.10"
  },
  "packageManager": "pnpm@10.7.1"
}
