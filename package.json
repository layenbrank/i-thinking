{
  "private": true,
  "name": "turborepo-example",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:extension": "turbo run dev --filter=extension",
    "dev:example": "turbo run dev --filter=example",
    "dev:devtools": "turbo run dev --filter=devtools",
    "dev:docs": "turbo run dev --filter=docs",
    "build": "turbo run build",
    "build:extension": "turbo run build --filter=extension",
    "build:fresh:extension": "turbo clean && turbo run build --filter=extension",
    "build:example": "turbo run build --filter=example",
    "build:devtools": "turbo run build --filter=devtools",
    "build:docs": "turbo run build --filter=docs",
    "cmd": "tsx scripts/index.ts",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,vue,md}\""
  },
  "dependencies": {
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/chrome": "^0.0.308",
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "eslint": "^9.20.1",
    "eslint-plugin-oxlint": "^0.15.10",
    "eslint-plugin-vue": "^9.32.0",
    "figlet": "^1.8.0",
    "find-up": "^7.0.0",
    "gradient-string": "^3.0.0",
    "inquirer": "^12.4.2",
    "jiti": "^2.4.2",
    "npm-run-all2": "^7.0.2",
    "ora": "^8.2.0",
    "oxlint": "^0.15.10",
    "postcss": "^8.5.3",
    "prettier": "^3.5.1",
    "sass": "^1.85.1",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "~5.7.3",
    "unplugin-auto-import": "^19.1.1",
    "unplugin-vue-components": "^28.4.1",
    "vite": "^6.1.0",
    "vite-plugin-vue-devtools": "^7.7.2",
    "vue-tsc": "^2.2.2"
  },
  "packageManager": "pnpm@8.15.6"
}
