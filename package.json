    "fuse.js": "^7.1.0",
    "lodash-es": "^4.17.21",
    "lunisolar": "^2.5.2",
    "monaco-editor": "^0.52.2",
    "naive-ui": "^2.41.0",
    "pinia": "^3.0.1",
    "rxjs": "^7.8.1",
    "sortablejs": "^1.15.6",
    "swiper": "^11.2.5",
    "tyme4ts": "^1.2.2",
