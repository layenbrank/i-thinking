		"@tiptap/vue-3": "^3.0.9",
		"@vicons/ionicons5": "^0.13.0",
		"@vueuse/core": "^13.6.0",
		"@vueuse/integrations": "^13.6.0",
		"@vueuse/shared": "^13.6.0",
		"ant-design-vue": "^4.2.6",
		"axios": "^1.11.0",
		"crypto-js": "^4.2.0",
		"dayjs": "^1.11.13",
		"deep-pick-omit": "^1.2.1",
		"dexie": "^4.0.11",
		"dexie-cloud-addon": "^4.0.12",
