{
	"创建application模版": {
		"prefix": "create-application",
		"body": [
			"<script setup lang=\"tsx\">",
			"import { useSettings } from '@/hooks/application-settings.ts'",
			"import ApplicationIcon from './app-example-icon.vue'",
			"import ApplicationWindow from './app-example-window.vue'",
			"",
			"defineOptions({",
			"\tname: 'app-example'",
			"})",
			"",
			"const props = withDefaults(",
			"\tdefineProps<{",
			"\t\tapplication?: Application",
			"\t\tsettingsVisible?: boolean",
			"\t}>(),",
			"\t{",
			"\t\tapplication() {",
			"\t\t\treturn {",
			"\t\t\t\tid: '0',",
			"\t\t\t\twidth: '60px',",
			"\t\t\t\theight: '60px',",
			"\t\t\t\tapp: 'app-example',",
			"\t\t\t\tround: '12px',",
			"\t\t\t\tsize: 'medium',",
			"\t\t\t\tslideID: '0',",
			"\t\t\t\tsort: 0,",
			"\t\t\t\tname: 'example',",
			"\t\t\t\tdirection: 'horizontal',",
			"\t\t\t\tshape: 'square',",
			"\t\t\t\tbackgroundColor: '#ffffff4d',",
			"\t\t\t\tbackgroundImage: null,",
			"\t\t\t\ttextSize: '13px',",
			"\t\t\t\ttextColor: '#ffffff',",
			"\t\t\t\tdescription: '书签',",
			"\t\t\t\tdownloadCount: 1000",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			")",
			"",
			"const visible = ref(false)",
			"const fullscreen = ref(false)",
			"",
			"const round = computed(function () {",
			"\treturn props.application.round ?? 'var(--app-global-round)'",
			"})",
			"",
			"const background = computed(function () {",
			"\tconst backgroundImage = `url(\\${props.application.backgroundImage}) no-repeat center / cover`",
			"\tif (props.application.backgroundImage) return backgroundImage",
			"\tif (props.application.backgroundColor) return props.application.backgroundColor",
			"\treturn '#ffffff'",
			"})",
			"",
			"const componentStyle = computed(function () {",
			"\treturn useSettings(props.application)",
			"})",
			"",
			"function handleAppWindow(value: boolean) {",
			"\tif (props.settingsVisible) return",
			"\tvisible.value = value",
			"}",
			"",
			"function updateFullScreen(value: boolean) {",
			"\tfullscreen.value = value",
			"}",
			"</script>",
			"",
			"<template>",
			"\t<div",
			"\t\t:style=\"{",
			"\t\t\t'--app-round': round,",
			"\t\t\t'--app-background': background,",
			"\t\t\t'--app-size-width': componentStyle.width,",
			"\t\t\t'--app-grid-row': componentStyle.gridRow,",
			"\t\t\t'--app-size-height': componentStyle.height,",
			"\t\t\t'--app-grid-column': componentStyle.gridColumn",
			"\t\t}\"",
			"\t\t:class=\"['app-example', application.size, application.shape, application.direction]\"",
			"\t>",
			"\t\t<a-modal",
			"\t\t\twidth=\"80%\"",
			"\t\t\t:icon=\"null\"",
			"\t\t\t:title=\"null\"",
			"\t\t\t:footer=\"null\"",
			"\t\t\t:open=\"visible\"",
			"\t\t\t:centered=\"true\"",
			"\t\t\t:closable=\"false\"",
			"\t\t\t:mask-closable=\"true\"",
			"\t\t\t:destroy-on-close=\"true\"",
			"\t\t\t@update:open=\"handleAppWindow\"",
			"\t\t\t:style=\"{",
			"\t\t\t\ttransformOrigin: 'center'",
			"\t\t\t}\"",
			"\t\t\tclass=\"application-window example-window\"",
			"\t\t>",
			"\t\t\t<application-window",
			"\t\t\t\t:fullscreen=\"fullscreen\"",
			"\t\t\t\t@update:visible=\"handleAppWindow\"",
			"\t\t\t\t@update:fullscreen=\"updateFullScreen\"",
			"\t\t\t/>",
			"\t\t</a-modal>",
			"\t\t<application-icon",
			"\t\t\t@dblclick=\"handleAppWindow(true)\"",
			"\t\t\t:class=\"[application.size, application.shape, application.direction]\"",
			"\t\t/>",
			"\t\t<span class=\"app-name\">{{ application.name }}</span>",
			"\t\t<i-local:close class=\"app-trash-icon\" />",
			"\t</div>",
			"</template>",
			"",
			"<style lang=\"scss\" scoped>",
			".app-example {",
			"\twidth: var(--app-size-width);",
			"\tgrid-row: var(--app-grid-row);",
			"\theight: var(--app-size-height);",
			"\tborder-radius: var(--app-round);",
			"\tgrid-column: var(--app-grid-column);",
			"}",
			"</style>",
			"<style lang=\"scss\">",
			".application-window.example-window {",
			"\t%size-full {",
			"\t\twidth: 100%;",
			"\t\theight: 100%;",
			"\t}",
			"",
			"\tdiv[tabindex='0'][style='outline: none;'] {",
			"\t\t@extend %size-full;",
			"\t}",
			"",
			"\t.ant-modal-content,",
			"\t.ant-modal-body,",
			"\t.ant-modal-confirm-body-wrapper,",
			"\t.ant-modal-confirm-body,",
			"\t.ant-modal-confirm-content {",
			"\t\t@extend %size-full;",
			"\t}",
			"",
			"\t.ant-modal-content {",
			"\t\tbackground-color: transparent;",
			"\t}",
			"",
			"\t.ant-modal-body {",
			"\t\tborder-radius: 8px;",
			"\t\tbackground-color: rgba(\\$color: #ffffff, \\$alpha: 1);",
			"\t}",
			"}",
			"</style>",
			""
		],
		"description": "创建application模版"
	},
