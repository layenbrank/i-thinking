{
  "创建app模版": {
    "prefix": "create-app",
    "body": [
      "<script setup lang=\"tsx\">",
      "import clsx from 'clsx'",
      "import { Modal } from 'ant-design-vue'",
      "import AppIcon from './app-test-icon.vue'",
      "import AppWindow from './app-test-window.vue'",
      "",
      "defineOptions({",
      "  name: 'app-test'",
      "})",
      "",
      "const props = withDefaults(",
      "  defineProps<{",
      "    slideApp: SlideApp",
      "    titleVisible?: boolean",
      "  }>(),",
      "  {",
      "    titleVisible: true",
      "  }",
      ")",
      "",
      "const appWindowRef = ref<AppWindowType>()",
      "",
      "function handleAppWindow() {",
      "  appWindowRef.value = Modal.info({",
      "    icon: null,",
      "    title: null,",
      "    footer: null,",
      "    centered: true,",
      "    width: '1000px',",
      "    maskClosable: true,",
      "    class: clsx('app-dialog test-window'),",
      "    content() {",
      "      return <AppWindow slideApp={props.slideApp} appWindowRef={appWindowRef.value} class={[]} />",
      "    }",
      "  })",
      "}",
      "</script>",
      "",
      "<template>",
      "  <div class=\"app-test\">",
      "    <AppIcon @click=\"handleAppWindow\" :size=\"slideApp.iconSize\" />",
      "    <span v-if=\"titleVisible\" class=\"app-name\">{{ slideApp.title }}</span>",
      "    <IconLocalClose class=\"app-trash-icon\" />",
      "  </div>",
      "</template>",
      "",
      "<style lang=\"scss\" scoped>",
      ".app-test {",
      "}",
      "</style>",
      "<style lang=\"scss\">",
      ".app-dialog.test-window {",
      "}",
      "</style>",
      ""
    ],
    "description": "创建app模版"
  },
