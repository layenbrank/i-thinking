  "创建app模版": {
    "prefix": "create-app",
    "body": [
      "<script setup lang=\"tsx\">",
      "import clsx from 'clsx'",
      "import { Modal } from 'ant-design-vue'",
      "import AppIcon from './app-example-icon.vue'",
      "import AppDialog from './app-example-dialog.vue'",
      "",
      "defineOptions({",
      "  name: 'app-example'",
      "})",
      "",
      "const props = withDefaults(",
      "  defineProps<{",
      "    appSize: AppSize",
      "  }>(),",
      "  {",
      "    appSize: 'medium'",
      "  }",
      ")",
      "",
      "const appDialogRef = ref<AppDialog>()",
      "",
      "function handleAppDialog() {",
      "  appDialogRef.value = Modal.info({",
      "    icon: null,",
      "    title: null,",
      "    footer: null,",
      "    centered: true,",
      "    width: '1000px',",
      "    maskClosable: true,",
      "    class: clsx('app-dialog example-dialog'),",
      "    content() {",
      "      return <AppDialog appDialogRef={appDialogRef.value} />",
      "    }",
      "  })",
      "}",
      "</script>",
      "",
      "<template>",
      "  <div class=\"app-example\">",
      "    <AppIcon :app-size=\"appSize\" @click=\"handleAppDialog\" />",
      "    <span class=\"app-title\">example</span>",
      "    <IconLocalClose class=\"app-trash-icon\" />",
      "  </div>",
      "</template>",
      "",
      "<style lang=\"scss\" scoped>",
      ".app-example {",
      "}",
      "</style>",
      "<style lang=\"scss\">",
      ".app-dialog.example-dialog {",
      "}",
      "</style>",
      ""
    ],
    "description": "创建app模版"
  },
