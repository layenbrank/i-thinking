{
  "editor.smoothScrolling": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.mouseWheelZoom": true,
  "editor.wordWrap": "on",
  "editor.lineHeight": 1.5,
  "editor.fontSize": 16,
  "editor.fontFamily": "MesloLGM Nerd Font",
  "editor.fastScrollSensitivity": 10,
  "editor.guides.bracketPairs": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.suggestSelection": "recentlyUsedByPrefix",
  "editor.suggest.insertMode": "replace",
  "editor.autoClosingBrackets": "beforeWhitespace",
  "editor.autoClosingDelete": "always",
  "editor.autoClosingOvertype": "always",
  "editor.autoClosingQuotes": "beforeWhitespace",
  "editor.detectIndentation": false,
  "editor.tabSize": 2,
  "editor.stickyScroll.enabled": true,
  "editor.foldingImportsByDefault": true,
  "editor.wordSeparators": "`~!@%^&*()=+[{]}\\|;:'\",.<>/?（），。；：",
  "editor.minimap.enabled": true,
  "editor.foldingStrategy": "indentation",
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.linkedEditing": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.fixAll.eslint": "explicit"
  },
  "editor.quickSuggestions": {
    "other": true,
    "comments": true,
    "strings": true
  },
  "workbench.startupEditor": "none",
  "workbench.list.smoothScrolling": true,
  "workbench.tree.enableStickyScroll": true,
  "workbench.list.fastScrollSensitivity": 10,
  "workbench.editor.wrapTabs": true,
  "workbench.editor.customLabels.patterns": {
    "**/index.vue": "${dirname}.vue",
    "**/index.js": "${dirname}.js",
    "**/index.ts": "${dirname}.ts",
    "**/index.jsx": "${dirname}.jsx",
    "**/index.tsx": "${dirname}.tsx"
  },
  "terminal.integrated.fontSize": 16,
  "terminal.explorerKind": "external",
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyleInactive": "line",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.stickyScroll.enabled": true,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "search.searchEditor.singleClickBehaviour": "peekDefinition",
  "search.followSymlinks": false,
  "search.exclude": {
    "**/node_modules": true,
    "**/pnpm-lock.yaml": true,
    "**/package-lock.json": true,
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.gitignore": true,
    "**/.idea": true,
    "**/.svn": true,
    "**/.vscode": true,
    "**/build": true,
    "**/dist": true,
    "**/tmp": true,
    "**/yarn.lock": true
  },
  "files.autoSave": "onFocusChange",
  "files.encoding": "utf8",
  "files.trimFinalNewlines": true,
  "files.autoGuessEncoding": true,
  "files.trimTrailingWhitespace": false,
  "files.associations": {
    "*.vue": "vue"
  },
  "explorer.compactFolders": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.env": "$(capture).env.*",
    ".gitignore": ".gitattributes, .gitconfig, .gitpod.yml, .git*, git*",
    "tsconfig.json": "tsconfig.*.json, env.d.ts",
    "index.html": "*.html",
    "dist.pem": "dist.*",
    "vite.config.*": "jsconfig*, vitest.config.*, cypress.config.*, playwright.config.*, vite.config.*.ts",
    "eslint.config.ts": ".eslint*, eslint*, .prettier*, prettier*, .editorconfig, .lintstagedrc, .browserslistrc",
    "package.json": "package-lock.json, pnpm*, .yarnrc*, yarn*, .node-version, .npmrc",
    "tailwind.config.ts": "postcss.config.js, tailwind.config.ts, tailwind.config.cjs, tailwind.config.mjs, tailwind.config.jsx, tailwind.config.tsx, tailwind.config.jsx"
  },
  "html.format.wrapAttributes": "preserve",
  "html.format.wrapLineLength": 70,
  "html.format.indentHandlebars": true,
  "javascript.format.semicolons": "remove",
  "javascript.inlayHints.enumMemberValues.enabled": true,
  "javascript.inlayHints.functionLikeReturnTypes.enabled": false,
  "javascript.inlayHints.parameterNames.enabled": "none",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.suggest.autoImports": true,
  "javascript.preferences.quoteStyle": "single",
  "typescript.inlayHints.enumMemberValues.enabled": true,
  "typescript.format.semicolons": "remove",
  "typescript.locale": "zh-CN",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "typescript.suggest.autoImports": true,
  "typescript.preferences.quoteStyle": "single",
  "typescript.tsdk": "node_modules\\typescript\\lib",
  "typescript.autoClosingTags": true,
  "typescript.preferences.importModuleSpecifier": "relative",
  "vue.updateImportsOnFileMove.enabled": true,
  "vue.inlayHints.missingProps": true,
  "vue.autoInsert.dotValue": true,
  "vue.server.hybridMode": true,
  "vue.inlayHints.inlineHandlerLeading": true,
  "vue.inlayHints.optionsWrapper": true,
  "window.dialogStyle": "custom",
  "window.density.editorTabHeight": "compact",
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "vue"],
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "emmet.excludeLanguages": ["javascript", "typescript"],
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "javascriptreact",
    "vue-html": "html",
    "vue": "html"
  },
  "turboConsoleLog.includeLineNum": true,
  "turboConsoleLog.includeFilename": true,
  "turboConsoleLog.insertEmptyLineAfterLogMessage": true,
  "turboConsoleLog.insertEmptyLineBeforeLogMessage": true,
  "debug.showBreakpointsInOverviewRuler": true,
  "debug.console.fontSize": 16,
  "debug.javascript.unmapMissingSources": true,
  "debug.javascript.suggestPrettyPrinting": false,
  "notebook.compactView": true,
  "path-intellisense.mappings": {
    "@": "${workspaceFolder}/src"
  },
  "scm.inputFontSize": 16,
  "vscodeCustomCodeColor.highlightValue": ["v-resize", "v-debounce", "v-infiniteScroll"],
  "diffEditor.hideUnchangedRegions.enabled": true,
  "scss.lint.duplicateProperties": "warning",
  "css.lint.duplicateProperties": "warning",
  "marscode.chatLanguage": "cn"
}
