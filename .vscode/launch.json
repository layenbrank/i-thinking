{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "version": "0.2.0",
  "configurations": [
    {
      "type": "chrome",
      "name": "Desktop-D Debug Development",
      "request": "launch",
      "url": "http://localhost:10010",
      "env": { "NODE_ENV": "development" },
      "sourceMaps": true,
      "webRoot": "${workspaceFolder}/apps/desktop-d",
      "preLaunchTask": "pnpm dev:desktop-d",
      "sourceMapPathOverrides": {
        ".vite/deps/*": "${webRoot}/node_modules/.vite/deps/*",
        ".tmp": "${webRoot}/node_modules/.tmp/*",
        "@slide": "${webRoot}/node_modules/@slide/*",
        "/@fs/*": "${webRoot}/*",
        "/*": "${webRoot}/*",
        "/src/*": "${webRoot}/src/*",
        "/@/*": "${webRoot}/src/*",
        "/@vite/*": "${workspaceFolder}/node_modules/*",
        "/./*": "${webRoot}/*",
        "/components/*": "${webRoot}/src/components/*",
        "/node_modules/*": "${workspaceFolder}/node_modules/*",
        "/@id/*": "${webRoot}/src/*",
        "/@id/.*": "${webRoot}/src/*"
      },
      "smartStep": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/.vite/deps/**",
        "!**/node_modules/*/**"
      ],
      "skipFiles": [
        "<node_internals>/**",
        "${workspaceFolder}/node_modules/**/*.js",
        "**/node_modules/.vite/deps/**",
        "${workspaceFolder}/dist/desktop-d/**"
      ]
    },
    {
