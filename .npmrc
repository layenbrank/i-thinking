# npm 镜像源
registry=https://registry.npmmirror.com/

# electron 相关镜像配置
# 注意：pnpm 11+ 不再将 .npmrc 中的 electron_mirror 注入为 npm_config_* 环境变量
# 详见：markdown/electron-pnpm-install-troubleshooting.md
# 当前已通过 pnpm patch (patches/electron@40.10.2) 在 install.js 中设置 ELECTRON_MIRROR 默认值
electron_mirror=https://npmmirror.com/mirrors/electron/
electron-builder-binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
# 防止网络问题中断
electron_builder_binaries_retry=3

# node-sass 的淘宝镜像
sass_binary_site=https://npmmirror.com/mirrors/node-sass/

# 其他常用二进制包镜像
chromedriver_cdnurl=https://npmmirror.com/mirrors/chromedriver
operadriver_cdnurl=https://npmmirror.com/mirrors/operadriver
phantomjs_cdnurl=https://npmmirror.com/mirrors/phantomjs
selenium_cdnurl=https://npmmirror.com/mirrors/selenium
node_sqlite3_binary_host_mirror=https://npmmirror.com/mirrors


# pnpm 特定配置
strict-peer-dependencies=false
auto-install-peers=true
shamefully-hoist=true

node-linker = hoisted

# 提升策略（与 pnpm-workspace.yaml 配合使用）
# 将公共依赖提升到根目录，减少重复安装
# 注意：本地包 (@i-thinking/*) 不会被提升，保持独立
hoist-pattern[]=*
hoist-pattern[]=!@i-thinking/*

# 这些依赖会被提升到公共位置
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*typescript*
public-hoist-pattern[]=*vite*
public-hoist-pattern[]=*vitest*
public-hoist-pattern[]=*turbo*
public-hoist-pattern[]=*rollup*
public-hoist-pattern[]=*@rollup/*
public-hoist-pattern[]=*@nestjs/*
public-hoist-pattern[]=*jest*

# 仅构建这些依赖
only-built-dependencies[]=@nestjs/core
only-built-dependencies[]=@parcel/watcher
only-built-dependencies[]=@scarf/scarf
only-built-dependencies[]=@swc/core
only-built-dependencies[]=core-js
only-built-dependencies[]=electron
only-built-dependencies[]=esbuild
only-built-dependencies[]=msw
only-built-dependencies[]=unrs-resolver

