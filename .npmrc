# pnpm 11+：项目 .npmrc 仅保留注册源与认证
# 其它行为配置见 pnpm-workspace.yaml
# https://pnpm.io/zh/blog/releases/11.0
# https://pnpm.io/zh/npmrc

registry=https://registry.npmmirror.com/

# --- 认证示例（勿把 token 写进仓库；用用户级 auth.ini 或 CI 环境变量）---
# //registry.tiptap.dev/:_authToken=...
# CI（pnpm 11.10+）也可用：pnpm_config__auth='{"https://...":{"@":{"authToken":"..."}}}'
# https://pnpm.io/zh/blog/releases/11.10

# --- 以下不是 pnpm 配置：native / Electron 安装脚本读环境变量 ---
# 必须在本机或 CI 设置（pnpm 不再把 .npmrc 非认证项注入 npm_config_*）
# ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
# ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/
# SASS_BINARY_SITE=https://npmmirror.com/mirrors/node-sass/
# 详见 markdown/electron-pnpm-install-troubleshooting.md
