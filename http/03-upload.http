# ============================================================
# 上传模块 /api/v1/upload
# 鉴权: Bearer JWT（prepare/chunk/finalize/progress/cancel 需登录）
#       GET /upload/files/{hash} 可匿名访问
# 流程: signin → prepare → chunk → finalize → GET files/{hash}
# ============================================================

@host = http://127.0.0.1:3000
@username = admin
@password = 123456
@fileHash = e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

### POST /api/v1/auth/signin — 登录（必须先执行）
# @name signin
POST {{host}}/api/v1/auth/signin
Content-Type: application/json
Accept: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

###
@token = {{signin.response.body.data.token}}

### POST /api/v1/upload/prepare — 初始化上传
# Body: { name, size, hash, mime, chunk }
# @name prepare
POST {{host}}/api/v1/upload/prepare
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "name": "sample.pdf",
  "size": 1048576,
  "hash": "{{fileHash}}",
  "mime": "application/pdf",
  "chunk": 1048576
}

###
@uploadId = {{prepare.response.body.data.id}}

### POST /api/v1/upload/chunk — 上传分片
POST {{host}}/api/v1/upload/chunk
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=UploadBoundary

--UploadBoundary
Content-Disposition: form-data; name="id"

{{uploadId}}
--UploadBoundary
Content-Disposition: form-data; name="index"

0
--UploadBoundary
Content-Disposition: form-data; name="hash"

{{fileHash}}
--UploadBoundary
Content-Disposition: form-data; name="chunk"; filename="chunk-0.part"
Content-Type: application/octet-stream

< ./fixtures/chunk-0.bin
--UploadBoundary--

### POST /api/v1/upload/finalize — 完成上传
POST {{host}}/api/v1/upload/finalize
Authorization: Bearer {{token}}
Content-Type: application/json
Accept: application/json

{
  "id": "{{uploadId}}"
}

### GET /api/v1/upload/progress/{id} — 查询上传进度
GET {{host}}/api/v1/upload/progress/{{uploadId}}
Authorization: Bearer {{token}}
Accept: application/json

### DELETE /api/v1/upload/cancel/{id} — 取消上传
DELETE {{host}}/api/v1/upload/cancel/{{uploadId}}
Authorization: Bearer {{token}}
Accept: application/json

### GET /api/v1/upload/files/{hash} — 下载已完成文件
GET {{host}}/api/v1/upload/files/{{fileHash}}
Accept: application/octet-stream
