# Detect text files; keep CRLF in the working tree on Windows.
* text=auto eol=crlf

# Keep attributes file itself as text.
.gitattributes text eol=crlf

# Binary files — no line-ending conversion / text diff.
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.wasm binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.pdf binary
*.zip binary
*.7z binary
*.gz binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.lockb binary

# Polyglot sources — 显式声明为文本，行尾沿用上面的 CRLF 检出策略。
*.rs text
*.py text
*.pyi text
*.toml text

# 契约生成物：入库内容必须与生成器输出逐字节一致（LF），不接受行尾转换。
packages/types/src/openapi.d.ts text eol=lf

# Shell 脚本需要直接在 Linux CI 上执行，强制以 LF 入库。
*.sh text eol=lf
