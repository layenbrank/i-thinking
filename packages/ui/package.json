{
	"name": "@desktop-app/ui",
	"version": "0.0.0",
	"type": "module",
	"private": true,
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/types/index.d.ts",
			"css": "./dist/index.css"
		},
		"./styles.css": "./dist/index.css",
		"./ReSegment.vue": "./src/components/re-segment/re-segment.vue",
		"./ScrollbarX.vue": "./src/components/scrollbar-x/scrollbar-x.vue"
	},
	"scripts": {
		"dev": "vite",
		"build": "run-p type-check \"build-only {@}\" --",
		"build-only": "vite build",
		"type-check": "vue-tsc --build",
		"preview": "vite preview",
		"lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
		"lint:eslint": "eslint . --fix",
		"lint": "run-s lint:*",
		"format": "prettier --write src/"
	},
	"peerDependencies": {
		"vue": "^3.5.13",
		"tailwindcss": "^3.4.17",
		"ant-design-vue": "^4.2.6",
		"@iconify/json": "^2.2.318"
	},
	"devDependencies": {
		"@desktop-app/shared": "workspace:*",
		"@desktop-app/core": "workspace:*"
	}
}
