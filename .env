# 服务器配置
HOST=127.0.0.1
PORT=3000

# PostgreSQL（docker compose 服务 postgres）
DATABASE_URL=postgres://machenike:Li33333.@127.0.0.1:5432/i-thinking

# Redis（docker compose 服务 redis）
REDIS_URL=redis://127.0.0.1:6379
REDIS_POOL_SIZE=8

# Elasticsearch 9.4.3（docker：已关 xpack.security，用 HTTP）
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=corex_docs
ELASTICSEARCH_INSECURE=false
# 安全关闭时无需账号；若改为开启安全再填写：
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_API_KEY=id:key
# ELASTICSEARCH_CLOUD_ID=

# 通用密钥
SECRET="MJi#i!7BLQQMGh6PXVuZ@*0Aqv7c5S&It!fjFzGaPj$pbfo7%Z2LAyedNwW@S&nX"

# Auth 认证系统配置
