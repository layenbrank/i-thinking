# 服务器配置
HOST=127.0.0.1
PORT=3000

# PostgreSQL（与 docker-compose.yml 对齐）
DATABASE_URL=postgres://machenike:Li33333.@127.0.0.1:5432/i-thinking

# Redis（docker compose）
REDIS_URL=redis://127.0.0.1:6379
REDIS_POOL_SIZE=8

# Elasticsearch（docker compose 默认关闭安全，HTTP）
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=corex_docs
ELASTICSEARCH_INSECURE=false
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_API_KEY=id:key
# ELASTICSEARCH_CLOUD_ID=

# 通用密钥（请用 cargo run --bin generate 重新生成）
SECRET=change-me-secret

# Auth 认证系统配置
ENCRYPTION=argon2
JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long
# ENCRYPTION=aes 时必填：
# AES_KEY=

# 日志配置
RUST_LOG=info
LOG_DIR=logs
LOG_FILE=service.log
LOG_RETENTION_DAYS=14

# ENABLE_SWAGGER=true
