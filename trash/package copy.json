{
	"type": "module",
	"name": "desktop-app",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"build:client": "turbo run build --filter=@desktop-app/client",
		"build:core": "turbo run build --filter=@desktop-app/core",
		"build:devtools": "turbo run build --filter=@desktop-app/devtools",
		"build:docs": "turbo run build --filter=@desktop-app/docs",
		"build:extension": "turbo run build --filter=@desktop-app/extension",
		"build:service": "turbo run build --filter=@desktop-app/service",
		"cmd": "tsx scripts/commands/index.ts",
		"dev": "turbo run dev",
		"dev:client": "turbo run dev --filter=@desktop-app/client",
		"dev:devtools": "turbo run dev --filter=@desktop-app/devtools",
		"dev:docs": "turbo run dev --filter=@desktop-app/docs",
		"dev:extension": "turbo run dev --filter=@desktop-app/extension",
		"dev:service": "turbo run dev --filter=@desktop-app/service",
		"format": "prettier --write \"**/*.{ts,tsx,vue,md}\"",
		"lint": "turbo run lint",
		"preinstall": "run-p prepare:husky prepare:pnpm prepare:core",
		"prepare:husky": "husky",
		"prepare:pnpm": "npx only-allow pnpm",
		"prepare:core": "pnpm build:core",
		"preview": "turbo run preview",
		"preview:extension": "turbo run preview --filter=@desktop-app/extension"
	},
